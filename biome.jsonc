{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": ["!!**/.agents"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      },
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "style": {
        // Public contracts and the DomainEvents bivariance hack rely on
        // method-style signatures; property style would break both.
        "useConsistentMethodSignatures": "off",
        // WatchedList.compareItems implementations compare arguments only.
        "useThisInClassMethods": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.{test,spec,test-d,spec-d}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "**/__tests__/**/*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveClassesPerFile": "off"
          }
        }
      }
    }
  ]
}
